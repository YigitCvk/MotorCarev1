# MotorCare / BakımSuite staging env template.
# Secret values are intentionally blank or set to CHANGE_ME placeholders.
# Store real values in Portainer or a restricted server-side env file;
# never commit the populated file.

POSTGRES_DB=motorcare_staging
POSTGRES_USER=motorcare
POSTGRES_PASSWORD=

# Flat connection string — mirrors what the compose file assembles inline.
# Populate this if you need to override the compose-assembled value directly.
ConnectionStrings__DefaultConnection=Host=db;Database=motorcare_staging;Username=motorcare;Password=CHANGE_ME

JWT_ISSUER=https://staging-api.bakimsuite.com
JWT_AUDIENCE=https://staging.bakimsuite.com
JWT_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Flat JWT vars for environments that consume them directly (e.g. scripts, CI).
Jwt__Secret=CHANGE_ME_MIN_32_CHARS
Jwt__Issuer=https://staging-api.bakimsuite.com
Jwt__Audience=https://staging.bakimsuite.com

MOTORCARE_COMMIT_SHA=UNSET_DEPLOY_COMMIT
MOTORCARE_BUILD_TIME=UNSET_UTC_ISO8601

ELASTIC_URI=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_INDEX_FORMAT=motorcare-api-staging-{0:yyyy.MM}

API_HOST_PORT=5102
Storage__AttachmentsPath=/var/lib/motorcare/attachments
CORS_ALLOWED_ORIGINS=https://staging.bakimsuite.com
Cors__AllowedOrigins=https://staging.bakimsuite.com

# ---------------------------------------------------------------------------
# Email — Option A: Mailpit (staging smoke / email capture)
# Default when no real SMTP is configured. Mailpit runs as a sidecar container
# and captures all outbound emails. Web UI is at http://SERVER_IP:8025 (or via
# SSH tunnel: ssh -L 8025:localhost:8025 user@server).
# ---------------------------------------------------------------------------
Email__Provider=Smtp
Email__FromEmail=no-reply@bakimsuite.com
Email__FromAddress=noreply@staging.bakimsuite.com
Email__FromName=GarajPass
Email__SmtpHost=mailpit
Email__SmtpPort=1025
Email__SmtpUsername=
Email__SmtpPassword=
Email__EnableSsl=false
Email__UseDefaultCredentials=false
Email__AppBaseUrl=https://staging.bakimsuite.com
Email__SendEmails=true
Email__LogEmailBodyInDevelopment=false
MAILPIT_WEB_PORT=8025
# Leave empty to disable Mailpit HTTP Basic Auth on staging.
MAILPIT_UI_AUTH=

# Runtime limits and log retention. Tune upward if the host has spare capacity.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=0.75
API_MEM_LIMIT=768m
API_CPUS=1.00
MIGRATOR_MEM_LIMIT=768m
MIGRATOR_CPUS=1.00
MAILPIT_MEM_LIMIT=256m
MAILPIT_CPUS=0.25

# ---------------------------------------------------------------------------
# Email — Option B: Real SMTP (uncomment and fill to send actual emails)
# When switching to real SMTP, update SmtpHost/Port/Username/Password and
# set EnableSsl=true. Keep SendEmails=true.
# ---------------------------------------------------------------------------
# Email__SmtpHost=smtp.yourprovider.com
# Email__SmtpPort=587
# Email__SmtpUsername=
# Email__SmtpPassword=
# Email__EnableSsl=true

API_IMAGE=REGISTRY_URL/motorcare-api:staging-latest
MIGRATOR_IMAGE=REGISTRY_URL/motorcare-migrator:staging-latest
WEB_IMAGE=REGISTRY_URL/motorcare-web:staging-latest
WEB_HOST_PORT=3000
NEXT_PUBLIC_APP_NAME=BakımSuite
NEXT_PUBLIC_APP_URL=https://staging.bakimsuite.com
# Direct API base URL used by the web client-side and any future mobile app.
# On the web app this is exposed as NEXT_PUBLIC_API_BASE_URL and consumed via appConfig.apiBaseUrl.
NEXT_PUBLIC_API_BASE_URL=https://staging-api.bakimsuite.com
WEB_MEM_LIMIT=512m
WEB_CPUS=0.75
