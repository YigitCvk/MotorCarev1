# GarajPass production env template.
# Secret values are intentionally blank. Store real values in Portainer or a
# restricted server-side env file; never commit the populated file.

POSTGRES_DB=motorcare
POSTGRES_USER=motorcare_user
POSTGRES_PASSWORD=

JWT_ISSUER=GarajPass
JWT_AUDIENCE=GarajPass.Client
JWT_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

MOTORCARE_COMMIT_SHA=UNSET_DEPLOY_COMMIT
MOTORCARE_BUILD_TIME=UNSET_UTC_ISO8601

ALLOWED_HOSTS=api.garajpass.com;garajpass.com;www.garajpass.com
API_HOST_PORT=5002
Storage__AttachmentsPath=/var/lib/motorcare/attachments
CORS_ALLOWED_ORIGINS=https://garajpass.com;https://www.garajpass.com

Email__Provider=Smtp
Email__FromEmail=no-reply@garajpass.com
Email__FromName=GarajPass
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__EnableSsl=true
Email__UseDefaultCredentials=false
Email__AppBaseUrl=https://garajpass.com
Email__SendEmails=true
Email__LogEmailBodyInDevelopment=false

ELASTIC_URI=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_INDEX_FORMAT=motorcare-api-prod-{0:yyyy.MM}

# Runtime limits and log retention. Tune to the production host size.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=2.00
API_MEM_LIMIT=1g
API_CPUS=1.50
MIGRATOR_MEM_LIMIT=1g
MIGRATOR_CPUS=1.50

API_IMAGE=ghcr.io/yigitcvk/motorcare-api:production
MIGRATOR_IMAGE=ghcr.io/yigitcvk/motorcare-migrator:production
WEB_IMAGE=ghcr.io/yigitcvk/motorcare-web:production
WEB_HOST_PORT=3000
NEXT_PUBLIC_APP_URL=https://bakimsuite.com
# Direct API base URL consumed by appConfig.apiBaseUrl on client-side and by mobile apps.
# Mobile apps bypass the Next.js proxy and call this URL directly.
NEXT_PUBLIC_API_BASE_URL=https://api.garajpass.com
WEB_MEM_LIMIT=512m
WEB_CPUS=0.75
