@page "/forbidden"
@using MotorCare.App.Authorization
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Yetkisiz Erişim - GarajPass</PageTitle>

<div class="page-shell">
    <section class="error-state">
        <strong>Yetkisiz erişim</strong>
        <p>Bu sayfa veya işlem için rolünüzde gerekli yetki bulunmuyor.</p>
        @if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            <p class="small text-muted mt-2">İstenen adres: @ReturnUrl</p>
        }
        <div class="page-header-actions mt-3">
            <a class="app-btn-primary" href="@DefaultRoute">Uygun panele dön</a>
            <a class="app-btn-secondary" href="/settings/security">Güvenlik ayarları</a>
        </div>
    </section>
</div>

@code {
    private CurrentUserResponse? _user;

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string DefaultRoute => AppRoleAccess.GetDefaultRoute(_user?.Role);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _user = await AuthService.GetCurrentUserAsync();
        await InvokeAsync(StateHasChanged);
    }
}
